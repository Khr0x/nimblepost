{
  "compilerOptions": {
    "baseUrl": ".", "paths": { "$lib": ["./src/lib"], "$lib/*": ["./src/lib/*"] },
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler",
    "strict": true, "allowJs": true, "checkJs": true, "noEmit": true, "allowImportingTsExtensions": true, "isolatedModules": true,
    "verbatimModuleSyntax": true, "resolveJsonModule": true, "skipLibCheck": true,
    "lib": ["ES2022", "DOM"], "types": ["svelte", "vite/client"]
  },
  "include": ["src/**/*.ts", "src/**/*.svelte", "vite.config.ts", "svelte.config.js"]
}
